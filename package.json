{
  "name": "llmmemory",
  "version": "0.1.0",
  "description": "Long-term memory for AI coding agents. Plain Markdown memories, recalled into every session through hooks and an MCP server.",
  "type": "module",
  "bin": {
    "llmmemory": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/aiagentflow/llmmemory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiagentflow/llmmemory.git"
  },
  "bugs": {
    "url": "https://github.com/aiagentflow/llmmemory/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "memory",
    "ai-agents",
    "llm",
    "claude-code",
    "mcp",
    "context",
    "cli"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  }
}
