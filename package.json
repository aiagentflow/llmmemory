{
  "name": "llmmemory",
  "version": "0.4.0",
  "description": "Long-term memory for AI coding agents. Plain Markdown memories, recalled into every session through hooks and an MCP server. Works with Claude Code, Codex CLI, Gemini CLI, Cursor and Antigravity CLI.",
  "type": "module",
  "bin": {
    "llmmemory": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://aiagentflow.dev/llmmemory",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiagentflow/llmmemory.git"
  },
  "bugs": {
    "url": "https://github.com/aiagentflow/llmmemory/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "memory",
    "agent-memory",
    "ai-agents",
    "llm",
    "claude-code",
    "codex",
    "gemini-cli",
    "cursor",
    "antigravity",
    "mcp",
    "context",
    "cli"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "version": "node -e \"require('fs').writeFileSync('src/version.ts', 'export const VERSION = ' + JSON.stringify(process.env.npm_package_version) + ';\\n')\" && git add src/version.ts",
    "test": "npm run build && node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  }
}
